{
  "name": "arbitrage_detector_v1",
  "type": "decision_tree",
  "description": "Triggers if price difference exceeds threshold after gas/slippage",
  "root": {
    "feature": "price_diff_percent",
    "threshold": 0.8,
    "left": {
      "value": "hold"
    },
    "right": {
      "feature": "estimated_profit_after_gas",
      "threshold": 0.3,
      "left": { "value": "hold" },
      "right": { "value": "execute_arbitrage" }
    }
  },
  "features_order": ["price_diff_percent", "estimated_profit_after_gas", "slippage_bps", "network_congestion"],
  "on_chain_friendly": true
}